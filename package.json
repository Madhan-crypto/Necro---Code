{
  "name": "refactor-radar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run typecheck && npm test",
    "build": "next build",
    "check": "npm run build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ts-morph": "24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.15.29",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true
  }
}
